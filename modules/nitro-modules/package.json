{
  "name": "@react-native-gpui/nitro-modules",
  "version": "0.37.0-alpha.1",
  "description": "Adapter for react-native-nitro-modules (MIT): runs Nitro Hybrid Objects and Nitro Views written in C++ on the desktop renderer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetwriters/react-native-gpui-modules.git",
    "directory": "modules/nitro-modules"
  },
  "homepage": "https://github.com/streetwriters/react-native-gpui-modules/tree/main/modules/nitro-modules#readme",
  "bugs": {
    "url": "https://github.com/streetwriters/react-native-gpui-modules/issues"
  },
  "files": [
    "desktop",
    "docs",
    "src",
    "react-native.config.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/*.test.ts",
    "!**/*.test.cjs"
  ],
  "peerDependencies": {
    "react-native": "0.87.x",
    "react-native-nitro-modules": "0.37.x"
  },
  "codegenConfig": {
    "name": "GPUINitroModulesSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
